# Postgres 연결 문자열 (Vercel의 Storage → Neon 연동 시 자동으로 만들어지는
# DATABASE_URL 값을 그대로 복사해서 넣으면 됩니다)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# 관리자 로그인 비밀번호. 원하는 값으로 바꿔서 사용하세요.
ADMIN_PASSWORD="원하는_관리자_비밀번호로_변경하세요"

# 로그인 쿠키 서명에 쓰는 비밀 키. 충분히 긴 임의의 문자열로 바꿔서 사용하세요.
# (openssl rand -hex 32 등으로 생성하면 좋습니다)
SESSION_SECRET="원하는_긴_임의의_문자열로_변경하세요"
