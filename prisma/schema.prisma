// 구구단 레벨업 시스템 - 데이터 모델
// 학생(Student)은 이름 + PIN(숫자 비밀번호)으로 로그인한다.
// 배포(Vercel) 환경에서는 로컬 파일이 유지되지 않으므로 Postgres를 사용한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 학생
model Student {
  id                 String   @id @default(cuid())
  name               String   @unique
  pinHash            String
  // 로그인 검증(pinHash)과 별개로, 관리자가 기존 PIN을 다시 확인할 수 있도록 대칭키로
  // 암호화해 저장해두는 값. 이 필드가 생기기 전에 등록된 학생은 null이며, PIN을 한 번
  // 재설정하면 그 다음부터 채워진다.
  pinEncrypted       String?
  level              Int      @default(1) // 1~4 = 도전 중인 단계, 5 = 마스터
  streak             Int      @default(0) // 오늘의 테스트 연속 응시일
  lastDailyTestDate  String? // YYYY-MM-DD (KST 기준)
  createdAt          DateTime @default(now())

  // 관리자가 학생별로 "오늘의 테스트" 출제 범위를 직접 지정할 때 사용.
  // customTables가 비어있으면(기본) 단계(level) 기준 자동 범위를 그대로 쓴다.
  customTables    Int[]    @default([]) // 관리자가 체크한 단(段) 목록, 예: [2,3,4]
  customCount     Int? // 관리자가 지정한 문항 수. null이면 단 수에 맞춰 자동 산정
  allowDuplicates Boolean  @default(false) // 체크 시 같은 문제가 여러 번 나올 수 있음
  problemOrder    String   @default("random") // "random" | "sequential" | "reverse"

  dailyTests     DailyTest[]
  levelExams     LevelExam[]
  levelUps       LevelUp[]
  retestAttempts RetestAttempt[]
}

// 오늘의 테스트 응시 기록 (하루 1회)
model DailyTest {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       String // YYYY-MM-DD (KST 기준)
  score      Int
  total      Int
  elapsedSec Int?
  detail     Json // [{a,b,answer,given,correct}]
  takenAt    DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId, takenAt])
}

// 승급 시험 응시 기록 (같은 단계는 하루 1회)
model LevelExam {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level      Int
  date       String // YYYY-MM-DD (KST 기준)
  score      Int
  total      Int
  passed     Boolean
  timedOut   Boolean  @default(false)
  elapsedSec Int?
  detail     Json
  takenAt    DateTime @default(now())

  @@unique([studentId, level, date])
  @@index([studentId, takenAt])
}

// 오답 재테스트 기록 - 그동안 틀렸던 문제만 모아서 다시 푸는 연습.
// 하루 1회 제한이나 스트릭/자격 기준 계산에는 영향을 주지 않는 별도의 연습 기록이다.
model RetestAttempt {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score      Int
  total      Int
  elapsedSec Int?
  detail     Json // [{a,b,answer,given,correct}]
  takenAt    DateTime @default(now())

  @@index([studentId, takenAt])
}

// 레벨업(승급 통과) 이력 - 보상(셀레나 달러/간식쿠폰) 지급 체크리스트로도 사용
model LevelUp {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       Int // 통과한 단계
  awardedAt   DateTime @default(now())
  rewardGiven Boolean  @default(false)
  rewardNote  String   @default("")

  @@index([studentId])
}
